# ----------------------------------------------------------------------------
# Copy to `.env.local` and fill in. All server vars are validated by lib/env.ts.
# ----------------------------------------------------------------------------

# Neon Postgres pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# OpenAI — used for text generation, content improvement, and image generation.
OPENAI_API_KEY="sk-..."

# Resend — delivers the login OTP email.
# Leave RESEND_API_KEY empty in dev to log the OTP to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="AI Marketing Suite <onboarding@resend.dev>"

# Public base URL (browser-exposed). Match BETTER_AUTH_URL locally.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
