# ----------------------------------------------------------------------------
# Copy to `.env.local` and fill in. All server vars are validated by lib/env.ts.
# The defaults below work out-of-the-box with `docker compose up -d`.
# ----------------------------------------------------------------------------

# Postgres.
# Local (docker-compose): use the value below as-is.
# Production: a Neon connection string, e.g.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_marketing_suite"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# OpenAI — used for text generation, content improvement, and image generation.
OPENAI_API_KEY="sk-..."

# Vercel Blob — stores generated images. Create a store in the Vercel dashboard
# (Storage → Blob) and paste its read-write token. Required for image generation.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Email transport (resolved in this order: SMTP → Resend → console log).
# Local (docker-compose): Mailpit captures everything — view it at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AI Marketing Suite <noreply@localhost>"
# Production free options (set SMTP_* above, no domain needed for Brevo/Gmail):
#   Brevo  — smtp-relay.brevo.com:587  (300 emails/day free)
#   Gmail  — smtp.gmail.com:587        (use an App Password)
# Or use Resend instead by setting this and leaving SMTP_HOST empty:
RESEND_API_KEY=""

# Public base URL (browser-exposed). Match BETTER_AUTH_URL locally.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
